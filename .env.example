# health-db environment configuration
# Copy to .env (gitignored) and fill in real values. Never commit .env.

# --- PostgreSQL  (host) — slice 2 ---
# Real host/port/password go in your private .env only (never committed).
# PSQL_URL is the LAN IP or hostname; PSQL_PORT is the postgres
# container's published port on the host (docker-compose.yml reaches the DB
# over the host, so no shared Docker network is needed).
PSQL_USER=health_app
PSQL_TABLE=health_app
PSQL_PASSWORD=change-me
PSQL_URL=your-docker-hostname
PSQL_PORT=5432

# --- Ingest auth ---
# Secret value HAE sends in the ingest header. Generate with: openssl rand -hex 32
INGEST_SECRET=change-me
# Header name HAE automation uses for the token (configurable)
INGEST_HEADER=X-Ingest-Token

# --- Limits ---
# Maximum accepted request body size in bytes (413 above this; default 64 MiB)
MAX_PAYLOAD_BYTES=67108864

# --- Server bind ---
# Interface and port for the ingest service (defaults: 0.0.0.0:8000)
# HOST=0.0.0.0
# PORT=8000

# --- MCP query server (separate process/port from ingest) ---
# uv run health-mcp serves streamable-http at /mcp with Bearer auth
# (Authorization: Bearer <INGEST_SECRET> — same secret as ingest).
# Defaults: 0.0.0.0:8100
# MCP_HOST=0.0.0.0
# MCP_PORT=8100
# Host names/IPs (with optional port) accepted in the Host header, in addition
# to the localhost defaults. REQUIRED when clients reach MCP through the
# Docker reverse proxy or any non-localhost name — without it the request
# is rejected with 421 "Invalid Host header" before auth runs.
# MCP_ALLOWED_HOSTS=healthbox.example:8443,healthbox.example

# --- Misc ---
# Override the reported app version (defaults to the package version; optional)
# APP_VERSION=0.1.0
